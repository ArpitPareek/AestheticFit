# Copy to .env.seed (gitignored) and fill in real values before running seed scripts.
#
#   cp .env.seed.example .env.seed
#   node --env-file=.env.seed scripts/seed-coach-plans.ts   # (or: npx tsx ...)
#
# The two Auth user IDs are secrets and MUST NOT be committed. .env.seed is
# already covered by .gitignore.

# Supabase project — service role key is required because coach plans are
# written on behalf of users and workout_plans is RLS-protected.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The two pre-seeded Auth user IDs (auth.users.id).
SEED_USER_A=00000000-0000-0000-0000-000000000000
SEED_USER_B=00000000-0000-0000-0000-000000000000
